---
/* ── One-page Home (/) ── */
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import StackSection from "../components/sections/StackSection.astro";
import AISection from "../components/sections/AISection.astro";
import ExperienceSection from "../components/sections/ExperienceSection.astro";
import ProjectsTeaser from "../components/sections/ProjectsTeaser.astro";
import ContactSection from "../components/sections/ContactSection.astro";
import { site } from "../data/site";
---

<BaseLayout
    title={site.seo.defaultTitle}
    description={site.seo.defaultDescription}
>
    <div data-onepage>
        <HeroSection lang="es" />
        <StackSection lang="es" />
        <AISection lang="es" />
        <ExperienceSection lang="es" />
        <ProjectsTeaser lang="es" />
        <ContactSection lang="es" />
    </div>

    <script>
        import "../scripts/onepage.ts";
    </script>
</BaseLayout>
