---
/* ── One-page Home (/en) ── */
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import StackSection from "../../components/sections/StackSection.astro";
import AISection from "../../components/sections/AISection.astro";
import ExperienceSection from "../../components/sections/ExperienceSection.astro";
import ProjectsTeaser from "../../components/sections/ProjectsTeaser.astro";
import ContactSection from "../../components/sections/ContactSection.astro";
import { site } from "../../data/site";
---

<BaseLayout
    title={site.seo.defaultTitleEn}
    description={site.seo.defaultDescriptionEn}
>
    <div data-onepage>
        <HeroSection lang="en" />
        <StackSection lang="en" />
        <AISection lang="en" />
        <ExperienceSection lang="en" />
        <ProjectsTeaser lang="en" />
        <ContactSection lang="en" />
    </div>

    <script>
        import "../../scripts/onepage.ts";
    </script>
</BaseLayout>
