---
/* ── One-page: Stack técnico (pinned horizontal rail on desktop) ── */
import TechBadge from "../ui/TechBadge.astro";
import ProjectTechLogoLoop from "../home/ProjectTechLogoLoop";
import { skillCategories } from "../../data/skills";
import { getProjectTechLogos } from "../../data/project-tech-logos";
import { onePageCopy, type Lang } from "../../data/onepage";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = onePageCopy[lang].stack;
const techCount = skillCategories.reduce(
    (total, category) => total + category.skills.length,
    0,
);
const projectTechLogos = getProjectTechLogos();
---

<section
    id="stack"
    data-spy-section
    class="relative border-t border-ui-border/40 bg-bg-primary"
>
    <div
        data-stack-pin
        class="flex flex-col justify-center overflow-hidden py-20 sm:py-24 lg:h-screen lg:py-0"
    >
        <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="mb-10 flex flex-wrap items-end justify-between gap-6 lg:mb-14">
                <div class="max-w-2xl">
                    <p class="mb-3 text-[0.68rem] font-semibold uppercase tracking-[0.32em] text-accent">
                        {t.eyebrow}
                    </p>
                    <h2
                        class="text-3xl font-black tracking-tight text-text-primary sm:text-4xl lg:text-5xl"
                        data-st-title
                    >
                        {t.title}
                    </h2>
                    <p class="mt-4 max-w-xl text-base leading-relaxed text-text-muted sm:text-lg" data-reveal>
                        {t.subtitle}
                    </p>
                </div>
                <div class="hidden items-center gap-3 lg:flex" data-reveal>
                    <span class="text-4xl font-black text-secondary">{techCount}</span>
                    <span class="max-w-[10rem] text-[0.68rem] font-semibold uppercase leading-snug tracking-[0.18em] text-text-muted">
                        {t.inProduction}
                    </span>
                </div>
            </div>
        </div>

        <!-- Rail -->
        <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:max-w-none lg:px-0">
            <div
                data-stack-track
                class="flex flex-col gap-5 lg:w-max lg:flex-row lg:gap-8 lg:pl-[max(2rem,calc((100vw-80rem)/2+2rem))] lg:pr-[12vw]"
            >
                {
                    skillCategories.map((category, index) => (
                        <article
                            data-stack-panel
                            class="group relative shrink-0 overflow-hidden rounded-[2rem] border border-white/10 bg-[linear-gradient(180deg,rgba(255,255,255,0.035),rgba(255,255,255,0.008))] p-6 backdrop-blur-sm transition-colors duration-300 hover:border-white/20 sm:p-8 lg:w-[30rem] lg:min-h-[24rem]"
                        >
                            <div
                                class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full opacity-[0.13] blur-3xl transition-opacity duration-500 group-hover:opacity-25"
                                style={`background:${category.accent};`}
                            />
                            <div data-stack-panel-inner>
                                <div class="flex items-start justify-between gap-4">
                                    <span
                                        class="flex h-14 w-14 items-center justify-center rounded-2xl border border-white/10 bg-black/30 text-4xl [&>svg]:h-[1em] [&>svg]:w-[1em]"
                                        set:html={category.icon}
                                    />
                                    <span class="text-5xl font-black leading-none text-white/8 select-none">
                                        0{index + 1}
                                    </span>
                                </div>
                                <h3 class="mt-6 text-2xl font-black tracking-tight text-text-primary">
                                    {lang === "en" ? category.titleEn : category.title}
                                </h3>
                                <p class="mt-2 text-sm leading-relaxed text-text-muted">
                                    {lang === "en" ? category.taglineEn : category.tagline}
                                </p>
                                <div class="mt-6 flex flex-wrap gap-1.5">
                                    {category.skills.map((skill) => (
                                        <TechBadge label={skill.name} variant="neutral" size="sm" />
                                    ))}
                                </div>
                            </div>
                        </article>
                    ))
                }
            </div>
        </div>

        <!-- Progress (desktop rail) -->
        <div class="mx-auto mt-10 hidden w-full max-w-7xl items-center gap-4 px-4 sm:px-6 lg:flex lg:px-8">
            <span class="text-[0.62rem] font-semibold uppercase tracking-[0.24em] text-text-dim">
                {t.panelHint}
            </span>
            <span class="relative block h-px flex-1 overflow-hidden bg-white/10">
                <span
                    data-stack-progress
                    class="absolute inset-0 origin-left bg-linear-to-r from-secondary to-accent"
                    style="transform: scaleX(0);"
                ></span>
            </span>
        </div>
    </div>

    <!-- Tech logo marquee -->
    <div class="border-t border-ui-border/40">
        <ProjectTechLogoLoop
            client:visible
            items={projectTechLogos}
            ariaLabel={lang === "en"
                ? "Technologies used in real projects"
                : "Tecnologías usadas en proyectos reales"}
        />
    </div>
</section>
