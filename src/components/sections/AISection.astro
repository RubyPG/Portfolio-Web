---
/* ── One-page: AI-Augmented Development (Claude Code) ── */
import { onePageCopy, type Lang } from "../../data/onepage";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = onePageCopy[lang].ai;

const cardIcons = [
    // Claude-style spark
    '<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="#D97757" d="M12 1.5l1.91 6.16a2 2 0 0 0 1.32 1.32l6.16 1.91a1.16 1.16 0 0 1 0 2.22l-6.16 1.91a2 2 0 0 0-1.32 1.32L12 22.5a1.16 1.16 0 0 1-2.22 0l-1.91-6.16a2 2 0 0 0-1.32-1.32L.39 13.11a1.16 1.16 0 0 1 0-2.22l6.16-1.91a2 2 0 0 0 1.32-1.32L9.78 1.5a1.16 1.16 0 0 1 2.22 0Z"/></svg>',
    // Layers (skills)
    '<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="none" stroke="#D97757" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m12 2l9 4.5l-9 4.5l-9-4.5zm-9 9l9 4.5l9-4.5m-18 5l9 4.5l9-4.5"/></svg>',
    // Plug (MCP)
    '<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="none" stroke="#D97757" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7V2m6 5V2M7 7h10v4a5 5 0 0 1-5 5a5 5 0 0 1-5-5zm5 9v6"/></svg>',
    // Branches (workflows)
    '<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="none" stroke="#D97757" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 3a3 3 0 1 0 0 6a3 3 0 0 0 0-6m12 12a3 3 0 1 0 0 6a3 3 0 0 0 0-6M6 9v3a3 3 0 0 0 3 3h6m-9 6v-9"/></svg>',
];
---

<section
    id="ia"
    data-spy-section
    class="relative overflow-hidden border-t border-ui-border/40 bg-bg-deep py-20 sm:py-28 lg:flex lg:min-h-svh lg:items-center lg:py-24"
>
    <!-- Grid lines + orange glow background -->
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div
            class="absolute inset-0 opacity-[0.05]"
            style="background-image:linear-gradient(rgba(255,255,255,0.5) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.5) 1px,transparent 1px);background-size:56px 56px;"
        ></div>
        <div class="absolute -left-24 top-1/4 h-96 w-96 rounded-full bg-[#D97757]/10 blur-3xl"></div>
        <div class="absolute -right-24 bottom-0 h-80 w-80 rounded-full bg-secondary/10 blur-3xl"></div>
    </div>

    <div class="relative mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 lg:self-center">
        <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
            <div>
                <p class="mb-3 text-[0.68rem] font-semibold uppercase tracking-[0.32em] text-[#D97757]">
                    {t.eyebrow}
                </p>
                <h2
                    class="text-3xl font-black tracking-tight text-text-primary sm:text-4xl lg:text-5xl"
                    data-st-title
                >
                    {t.title}
                </h2>
                <p class="mt-5 max-w-xl text-base leading-relaxed text-text-secondary sm:text-lg" data-reveal>
                    {t.subtitle}
                </p>

                <div class="mt-9 grid gap-4 sm:grid-cols-2" data-reveal-group>
                    {
                        t.cards.map((card, index) => (
                            <div
                                class="motion-surface rounded-2xl border border-white/10 bg-white/[0.025] p-5 transition-colors duration-300 hover:border-[#D97757]/35"
                                data-motion-active="false"
                                data-reveal
                            >
                                <span
                                    class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-[#D97757]/25 bg-[#D97757]/10 text-xl [&>svg]:h-[1em] [&>svg]:w-[1em]"
                                    set:html={cardIcons[index] ?? cardIcons[0]}
                                />
                                <h3 class="mt-4 text-base font-bold text-text-primary">
                                    {card.title}
                                </h3>
                                <p class="mt-1.5 text-sm leading-relaxed text-text-muted">
                                    {card.body}
                                </p>
                            </div>
                        ))
                    }
                </div>

                <p class="mt-8 border-l-2 border-[#D97757]/60 pl-4 text-sm font-medium italic text-text-secondary" data-reveal>
                    {t.footnote}
                </p>
            </div>

            <!-- Terminal -->
            <div data-reveal>
                <div
                    data-terminal
                    class="overflow-hidden rounded-2xl border border-white/12 bg-[#0b0d10] shadow-[0_32px_90px_rgba(0,0,0,0.5),0_0_60px_rgba(217,119,87,0.07)]"
                >
                    <div class="flex items-center gap-2 border-b border-white/8 bg-white/[0.03] px-4 py-3">
                        <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
                        <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
                        <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
                        <span class="ml-3 font-mono text-xs text-text-dim">{t.terminalTitle}</span>
                    </div>
                    <div class="min-h-[19rem] space-y-2.5 p-5 font-mono text-[0.8rem] leading-relaxed sm:text-sm">
                        {
                            t.terminalLines.map((line) => (
                                <div
                                    class="flex items-start gap-2 opacity-0"
                                    data-terminal-line
                                    data-prompt={line.prompt ? "true" : "false"}
                                    data-text={line.text}
                                >
                                    {line.prompt ? (
                                        <span class="shrink-0 select-none font-bold text-[#D97757]">❯</span>
                                    ) : (
                                        <span class="shrink-0 select-none text-state-success">·</span>
                                    )}
                                    <span
                                        class={line.prompt
                                            ? "text-text-primary"
                                            : "text-text-muted"}
                                        data-terminal-text
                                    />
                                </div>
                            ))
                        }
                        <div class="flex items-center gap-2 pt-1">
                            <span class="select-none font-bold text-[#D97757]">❯</span>
                            <span class="inline-block h-4 w-2 animate-pulse bg-[#D97757]/80"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
