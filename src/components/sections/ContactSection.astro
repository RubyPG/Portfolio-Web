---
/* ── One-page: Contacto ── */
import GitHubMark from "../icons/GitHubMark.astro";
import { site } from "../../data/site";
import { onePageCopy, type Lang } from "../../data/onepage";
import { withBasePath } from "../../utils/base-path";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = onePageCopy[lang].contact;
const cvHref = lang === "en" ? "/cv/en/" : "/cv/";
const mailSubject =
    lang === "en" ? "Project — let's talk" : "Proyecto — hablemos";
const mailHref = `mailto:${site.contact.email}?subject=${encodeURIComponent(mailSubject)}`;
const waHref = `https://wa.me/${site.contact.whatsapp}`;
const madeWith =
    lang === "en"
        ? "Built with Astro · GSAP · Claude Code"
        : "Hecho con Astro · GSAP · Claude Code";
const backToTop = lang === "en" ? "Back to top" : "Volver arriba";
---

<section
    id="contacto"
    data-spy-section
    class="relative overflow-hidden border-t border-ui-border/40 bg-bg-deep lg:flex lg:min-h-svh lg:flex-col"
>
    <!-- Glow background -->
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute left-1/2 top-0 h-px w-2/3 -translate-x-1/2 bg-linear-to-r from-transparent via-secondary/50 to-transparent"></div>
        <div class="absolute left-1/4 top-10 h-72 w-72 rounded-full bg-secondary/10 blur-3xl"></div>
        <div class="absolute bottom-0 right-1/4 h-72 w-72 rounded-full bg-accent/8 blur-3xl"></div>
    </div>

    <div class="relative mx-auto w-full max-w-5xl px-4 py-24 text-center sm:px-6 sm:py-32 lg:my-auto lg:py-24 lg:px-8">
        <p class="mb-4 text-[0.68rem] font-semibold uppercase tracking-[0.32em] text-accent">
            {t.eyebrow}
        </p>

        <h2
            class="font-black leading-[0.98] tracking-[-0.04em]"
            data-buddy-finale
            data-buddy-stop="top"
        >
            <span class="block text-[clamp(2.6rem,8vw,5.5rem)] text-text-primary">
                {t.titleLines[0]}
            </span>
            <span class="block text-[clamp(1.8rem,5vw,3.4rem)] text-text-muted">
                {t.titleLines[1]}
            </span>
        </h2>

        <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-text-secondary sm:text-lg">
            {t.subtitle}
        </p>

        <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a
                href={mailHref}
                class="inline-flex w-full items-center justify-center gap-2.5 rounded-xl bg-accent px-8 py-4 text-base font-bold text-bg-deep transition-colors hover:bg-accent-hover sm:w-auto"
                style="color: var(--bg-deep);"
                data-magnetic
            >
                <span class="button-content inline-flex items-center gap-2.5">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                    {t.email}
                </span>
            </a>
            <a
                href={waHref}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex w-full items-center justify-center gap-2.5 rounded-xl border border-state-success/50 px-8 py-4 text-base font-bold text-state-success transition-colors hover:bg-state-success/10 sm:w-auto"
                data-magnetic
            >
                <span class="button-content inline-flex items-center gap-2.5">
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
                    </svg>
                    {t.whatsapp}
                </span>
            </a>
            <a
                href={withBasePath(cvHref)}
                class="inline-flex w-full items-center justify-center gap-2.5 rounded-xl border border-white/20 px-8 py-4 text-base font-bold text-text-primary transition-colors hover:border-secondary hover:text-secondary sm:w-auto"
                data-magnetic
            >
                <span class="button-content inline-flex items-center gap-2.5">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                    </svg>
                    {t.cv}
                </span>
            </a>
        </div>

        <p class="mt-8 font-mono text-xs text-text-dim sm:text-sm">
            {t.responseNote}
        </p>

    </div>

    <!-- Integrated footer: the finale ends the page, no extra section after -->
    <div class="relative border-t border-white/8 bg-black/30">
        <div
            class="mx-auto flex w-full max-w-7xl flex-col items-center justify-between gap-4 px-4 py-6 sm:px-6 lg:flex-row lg:px-8"
        >
            <p class="text-xs text-text-dim">
                {site.footer.copyright}
            </p>
            <p class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-text-dim">
                {madeWith}
            </p>
            <div class="flex items-center gap-5">
                {
                    site.socials.map((social) => (
                        <a
                            href={social.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-text-muted transition-colors hover:text-secondary"
                            aria-label={social.label}
                        >
                            {social.icon === "github" && (
                                <GitHubMark class="h-5 w-5" />
                            )}
                            {social.icon === "linkedin" && (
                                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452z" />
                                </svg>
                            )}
                        </a>
                    ))
                }
                <span class="h-4 w-px bg-white/15" aria-hidden="true"></span>
                <a
                    href="#inicio"
                    class="inline-flex items-center gap-1.5 text-xs font-semibold text-text-muted no-underline transition-colors hover:text-accent"
                >
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
                    </svg>
                    {backToTop}
                </a>
            </div>
        </div>
    </div>
</section>
