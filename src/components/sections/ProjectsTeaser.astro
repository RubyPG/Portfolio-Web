---
/* ── One-page: Proyectos destacados (teaser hacia /proyectos) ── */
import TechBadge from "../ui/TechBadge.astro";
import { getFeaturedProjects } from "../../data/projects";
import { onePageCopy, type Lang } from "../../data/onepage";
import { withBasePath } from "../../utils/base-path";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = onePageCopy[lang].projects;
const pfx = lang === "en" ? "/en" : "";
const featured = getFeaturedProjects(3);
const marqueeWord = lang === "en" ? "PROJECTS" : "PROYECTOS";
---

<section
    id="proyectos"
    data-spy-section
    class="relative overflow-hidden border-t border-ui-border/40 bg-[#151515] py-20 sm:py-28 lg:flex lg:min-h-svh lg:items-center lg:py-24"
>
    <!-- Giant scrub marquee -->
    <div
        class="pointer-events-none absolute left-0 top-6 w-full select-none whitespace-nowrap"
        aria-hidden="true"
    >
        <span
            data-marquee="left"
            class="block text-outline text-[clamp(5rem,16vw,13rem)] font-black leading-none tracking-tight"
        >
            {`${marqueeWord} — ${marqueeWord} — ${marqueeWord}`}
        </span>
    </div>

    <div class="relative mx-auto mt-[clamp(4rem,12vw,9rem)] w-full max-w-7xl px-4 sm:px-6 lg:mt-24 lg:self-center lg:px-8">
        <div class="mb-12 flex flex-wrap items-end justify-between gap-6">
            <div class="max-w-2xl">
                <p class="mb-3 text-[0.68rem] font-semibold uppercase tracking-[0.32em] text-accent">
                    {t.eyebrow}
                </p>
                <h2
                    class="text-3xl font-black tracking-tight text-text-primary sm:text-4xl lg:text-5xl"
                    data-st-title
                   
                >
                    {t.title}
                </h2>
                <p class="mt-4 text-base leading-relaxed text-text-muted sm:text-lg" data-reveal>
                    {t.subtitle}
                </p>
            </div>
        </div>

        <div class="grid gap-6 md:grid-cols-3" data-reveal-group>
            {
                featured.map((project, index) => {
                    const detailHref = project.casePath
                        ? withBasePath(project.casePath)
                        : project.links.demo ?? undefined;
                    const Tag = detailHref ? "a" : "article";
                    const linkAttrs = detailHref
                        ? {
                              href: detailHref,
                              ...(project.casePath
                                  ? {}
                                  : {
                                        target: "_blank",
                                        rel: "noopener noreferrer",
                                    }),
                          }
                        : {};
                    return (
                        <Tag
                            class="project-card group flex min-h-[26rem] flex-col p-7 no-underline sm:p-8"
                            data-tilt
                            data-reveal
                            {...linkAttrs}
                        >
                            <div class="flex items-start justify-between gap-4">
                                <span class="rounded-full border border-secondary/25 bg-secondary/10 px-3 py-1 text-[0.62rem] font-bold uppercase tracking-[0.16em] text-secondary">
                                    {project.kind[lang]}
                                </span>
                                <span class="text-6xl font-black leading-none text-white/6 select-none">
                                    0{index + 1}
                                </span>
                            </div>

                            <h3 class="pc-title mt-6 text-[1.7rem] font-black leading-tight tracking-tight text-text-primary">
                                {project.title}
                            </h3>
                            <p class="mt-2 inline-flex items-center gap-2 text-[0.66rem] font-semibold uppercase tracking-[0.2em] text-text-dim">
                                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-state-success" aria-hidden="true"></span>
                                {project.context[lang]} · {project.status[lang]}
                            </p>
                            <p class="mt-4 flex-1 text-sm leading-relaxed text-text-muted">
                                {project.tagline[lang]}
                            </p>

                            <div class="mt-5 h-px w-full bg-linear-to-r from-secondary/40 via-white/10 to-transparent" aria-hidden="true"></div>

                            <div class="mt-5 flex flex-wrap gap-1.5">
                                {project.stack.slice(0, 4).map((tech) => (
                                    <TechBadge label={tech} variant="neutral" size="sm" />
                                ))}
                            </div>

                            <div class="mt-7 flex items-center justify-between">
                                <span class="text-sm font-black uppercase tracking-[0.14em] text-accent">
                                    {detailHref
                                        ? project.casePath
                                            ? t.viewCase
                                            : t.viewDemo
                                        : project.status[lang]}
                                </span>
                                <span class="pc-arrow inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/20 text-text-muted">
                                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                                    </svg>
                                </span>
                            </div>
                        </Tag>
                    );
                })
            }
        </div>

        <div class="mt-12 text-center" data-reveal>
            <a
                href={withBasePath(`${pfx}/proyectos`)}
                class="inline-flex items-center justify-center gap-2.5 rounded-xl border border-accent/50 px-8 py-3.5 text-base font-bold text-accent transition-colors hover:bg-accent hover:text-bg-deep"
                data-magnetic
            >
                <span class="button-content inline-flex items-center gap-2.5">
                    {t.ctaAll}
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </span>
            </a>
        </div>
    </div>
</section>
