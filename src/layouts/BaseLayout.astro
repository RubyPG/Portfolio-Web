---
/* ── BaseLayout ── */
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import MotionEffectsController from "../components/layout/MotionEffectsController";
import { site } from "../data/site";
import { stripBasePath, withBasePath } from "../utils/base-path";
import "../styles/globals.css";

interface Props {
    title?: string;
    description?: string;
    ogImage?: string;
    canonical?: string;
    /* One-page home integrates its own footer into the final scene */
    showFooter?: boolean;
}

const routePath = stripBasePath(Astro.url.pathname);
const isEn = routePath.startsWith("/en");
const htmlLang = isEn ? "en" : "es";
const ogLocale = isEn ? "en_US" : site.locale;

const defaultTitle = isEn ? site.seo.defaultTitleEn : site.seo.defaultTitle;
const defaultDescription = isEn
    ? site.seo.defaultDescriptionEn
    : site.seo.defaultDescription;

const {
    title,
    description = defaultDescription,
    ogImage = site.seo.ogImage,
    canonical,
    showFooter = true,
} = Astro.props;

/* Full titles (containing the site name) are used as-is; short page titles
   get the "%s | RubénPG" template. */
const pageTitle = !title
    ? defaultTitle
    : title.includes(site.shortName) || title.includes(site.name)
      ? title
      : site.seo.titleTemplate.replace("%s", title);

const canonicalOrigin = Astro.site ?? new URL(site.siteUrl);
const canonicalUrl =
    canonical || new URL(Astro.url.pathname, canonicalOrigin).href;
---

<!doctype html>
<html lang={htmlLang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />

        <!-- Mark JS availability before first paint (used for FOUC-safe reveals) -->
        <script is:inline>
            document.documentElement.classList.add("js");
        </script>

        <!-- SEO -->
        <title>{pageTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalUrl} />

        <!-- Open Graph -->
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        <meta
            property="og:image"
            content={new URL(withBasePath(ogImage), canonicalOrigin).href}
        />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content={ogLocale} />
        <meta property="og:site_name" content={site.shortName} />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        <meta
            name="twitter:image"
            content={new URL(withBasePath(ogImage), canonicalOrigin).href}
        />

        <!-- Favicon -->
        <link rel="icon" type="image/png" href={withBasePath("/favicon.png")} />

        <!-- Theme color -->
        <meta name="theme-color" content="#111111" />
    </head>
    <body class="bg-bg-primary text-text-primary min-h-screen flex flex-col">
        <Navbar />

        <MotionEffectsController client:load />

        <main class="grow pt-16">
            <slot />
        </main>

        {showFooter && <Footer />}
    </body>
</html>
